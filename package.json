{
  "name": "starry",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Starry — AI bookmark search. MV3 extension (fully local semantic search) with a CDP-driven dev loop.",
  "repository": {
    "type": "git",
    "url": "https://github.com/JCodesMore/starry-ai-bookmark-search.git"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "browser": "node tools/launch.mjs",
    "reload": "npm run build && node tools/reload.mjs",
    "smoke": "node tools/smoke.mjs",
    "import": "node tools/import-bookmarks.mjs",
    "package": "node tools/package.mjs",
    "release": "node tools/release.mjs",
    "stop": "node tools/stop.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gate": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@mozilla/readability": "^0.6.0"
  }
}
