{
  "manifest_version": 3,
  "name": "Starry — AI Bookmark Search",
  "version": "1.0.0",
  "description": "Find your bookmarks like a simple Google search. Local, private, and free. It just works.",
  "homepage_url": "https://github.com/JCodesMore/starry",
  "permissions": ["bookmarks", "offscreen", "favicon", "alarms"],
  "optional_host_permissions": ["<all_urls>"],
  "omnibox": { "keyword": "bm" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+B" },
      "description": "Search your bookmarks"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Starry",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
